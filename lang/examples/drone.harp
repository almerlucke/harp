// Not a synth of psalm at all: oscillators, a filter that moves and an echo. Everything is built in
// the language from a few functions.

bpm = 60

low  = saw([55, 55.2]).lowPass(cutoff: lfo(0.05).range(120, 900), res: 0.7)
high = sine([220, 330, 440]).gain(lfo([0.11, 0.07, 0.13]).range(0, 0.15))

out = (low * 0.3 + high.spread(width: 0.8)).echo(max: 2, time: [0.9, 1.3], feedback: 0.5, mix: 0.35)
