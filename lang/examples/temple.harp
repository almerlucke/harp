pilgrim = pilgrim_top.gain(0.27) + pilgrim_inner.gain(0.22) + pilgrim_low.gain(0.22)

bright = court + porch + nave_music + oracle_music + glory_music + pilgrim
dry = body + bright
hall = dry.highPass(cutoff: 180).reverb(mix: 1, decay: 5)
cloud = dry.shimmer(mix: 1, shimmer: 0.6, decay: 9, lowCut: 300)
cloud_level = curve(form, "Y1: 0, Wing1: 0 -> 0.02 smooth, Day1: 0.02 -> 0.04 smooth, Day2: 0.04")
arc = curve(form, "Y1: 0.8 -> 1 smooth, Court: 1.1, Doors: 1.15, L1: 1.15 -> 1.25 smooth, L10: 1.25, Wing1: 1.05, Day1: 1 -> 1.2 smooth, Day2: 1.2 -> 1.5 smooth")
out = ((dry + hall * 0.3 + cloud * cloud_level) * arc).gain(0.8)
