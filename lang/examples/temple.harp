  at(42, part("D2 - - - - - - - A2?92 - - - - - - - | D2 - - - - - - - D3?92 - - - A2?92 - - - | F#2 - - - - - - - C#3?92 - - - - - - - | F#2 - - - - - - - F#3?92 - - - C#3?92 - - - | A2 - - - - - - - E3?92 - - - - - - - | A2 - - - - - - - A3?92 - - - E3?92 - - - | D2 - - - - - - - A2?92 - - - - - - - | D2 - - - - - - - D3?92 - - - A2?92 - - - | F#2 - - - - - - - C#3?92 - - - - - - - | F#2 - - - - - - - F#3?92 - - - C#3?92 - - - | A2 - - - - - - - E3?92 - - - - - - - | A2 - - - - - - - A3?92 - - - E3?92 - - -", velocity: 0.42, legato: 0.95)),
