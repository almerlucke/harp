  at(83, part("F#2 - C#3 - F#3 - - - - - - - - - - -", velocity: 0.4, legato: 0.95)),
  at(88, part("D2 - - - A2?92 - - - D3?92 - - - F#3?92 - - - | D2 - - - A2?92 - - - D3?92 - - - F#3?92 - - - | D2 - - - A2?92 - - - D3?92 - - - F#3?92 - - - | D2 - - - A2?92 - - - D3?92 - - - F#3?92 - - - | A2 - - - E3?92 - - - A3?92 - - - E3?92 - - - | A2 - - - E3?92 - - - A3?92 - - - E3?92 - - - | D2 - - - A2?92 - - - D3?92 - - - F#3?92 - - -", velocity: 0.45, legato: 0.95)),
