  at(23, part("D2 - A2?90 - D3?90 - F#3?90 - A3?90 - F#3?90 - D3?90 - A2?90 - | D2 - - - A2?90 - - - D3?90 - F#3?90 - A3?90 - - - | D2 - A2?90 - D3?90 - E3?90 - A3?90 - E3?90 - D3?90 - A2?90 - | D2 - - - A2?90 - - - D3?90 - F#3?90 - A3?90 - - - | D2 - A2?90 - D3?90 - F#3?90 - A3?90 - F#3?90 - D3?90 - A2?90 -", velocity: 0.45, legato: 0.95)),
