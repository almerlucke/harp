pilgrim_inner = hand([
  at(42, part("D4 - F#4?88 - A4?88 - F#4?88 - D4?88 - F#4?88 - A4?88 - F#4?88 - | D4 - F#4?88 - A4?88 - F#4?88 - D4?88 - F#4?88 - A4?88 - F#4?88 - | F#4 - A4?88 - C#5?88 - A4?88 - F#4?88 - A4?88 - C#5?88 - A4?88 - | F#4 - A4?88 - C#5?88 - A4?88 - F#4?88 - A4?88 - C#5?88 - A4?88 - | A3 - C#4?88 - E4?88 - C#4?88 - A3?88 - C#4?88 - E4?88 - C#4?88 - | A3 - C#4?88 - E4?88 - C#4?88 - A3?88 - C#4?88 - E4?88 - C#4?88 - | D4 - F#4?88 - A4?88 - F#4?88 - D4?88 - F#4?88 - A4?88 - F#4?88 - | D4 - F#4?88 - A4?88 - F#4?88 - D4?88 - F#4?88 - A4?88 - F#4?88 - | F#4 - A4?88 - C#5?88 - A4?88 - F#4?88 - A4?88 - C#5?88 - A4?88 - | F#4 - A4?88 - C#5?88 - A4?88 - F#4?88 - A4?88 - C#5?88 - A4?88 - | A3 - C#4?88 - E4?88 - C#4?88 - A3?88 - C#4?88 - E4?88 - C#4?88 - | A3 - C#4?88 - E4?88 - C#4?88 - A3?88 - C#4?88 - E4?88 - C#4?88 -", velocity: 0.32, legato: 0.95)),
