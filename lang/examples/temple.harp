  at(88, part("F#4 - A4?88 - D5?88 - A4?88 - F#4?88 - A4?88 - D5?88 - A4?88 - | F#4 - A4?88 - D5?88 - A4?88 - F#4?88 - A4?88 - D5?88 - A4?88 - | F#4 - A4?88 - D5?88 - A4?88 - F#4?88 - A4?88 - D5?88 - A4?88 - | F#4 - A4?88 - D5?88 - A4?88 - F#4?88 - A4?88 - D5?88 - A4?88 - | E4 - A4?88 - E5?88 - A4?88 - E4?88 - A4?88 - E5?88 - A4?88 - | E4 - A4?88 - E5?88 - A4?88 - E4?88 - A4?88 - E5?88 - A4?88 - | F#4 - A4?88 - D5?88 - A4?88 - F#4?88 - A4?88 - D5?88 - A4?88 -", velocity: 0.32, legato: 0.95)),
  at(95, part("F#4 A4?82 D5?82 A4?82 F#4?82 A4?82 D5?82 A4?82 F#4?82 A4?82 D5?82 A4?82 F#4?82 A4?82 D5?82 A4?82 | F#4 A4?82 D5?82 A4?82 F#4?82 A4?82 D5?82 A4?82 F#4?82 A4?82 D5?82 A4?82 F#4?82 A4?82 D5?82 A4?82 | F#4 A4?82 D5?82 A4?82 F#4?82 A4?82 D5?82 A4?82 F#4?82 A4?82 D5?82 A4?82 F#4?82 A4?82 D5?82 A4?82 | F#4 A4?82 D5?82 A4?82 F#4?82 A4?82 D5?82 A4?82 F#4?82 A4?82 D5?82 A4?82 F#4?82 A4?82 D5?82 A4?82 | E4 A4?82 E5?82 A4?82 E4?82 A4?82 E5?82 A4?82 E4?82 A4?82 E5?82 A4?82 E4?82 A4?82 E5?82 A4?82 | E4 A4?82 E5?82 A4?82 E4?82 A4?82 E5?82 A4?82 E4?82 A4?82 E5?82 A4?82 E4?82 A4?82 E5?82 A4?82 | F#4 A4?82 D5?82 A4?82 F#4?82 A4?82 D5?82 A4?82 F#4?82 A4?82 D5?82 A4?82 F#4?82 A4?82 D5?82 A4?82", velocity: 0.3, legato: 0.95))])
pilgrim_low = hand([
