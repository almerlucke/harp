// SuperCollider (the kick of the 60Hz Gabber Rave 1995: a saw that falls from 4 octaves, clipped hard, split in a low and a high part)
//
//   {
//     var def, durations;
//     ~kick = SynthDef(\gabberkick, {
//         var snd, freq, high, lfo;
//         freq = \freq.kr(440) * (Env.perc(0.001, 0.08, curve: -1).ar * 48 * \bend.kr(1)).midiratio;
//         snd = Saw.ar(freq);
//         snd = (snd * 100).tanh + ((snd.sign - snd) * -8.dbamp);
//         high = HPF.ar(snd, 300);
//         lfo = SinOsc.ar(8, [0, 0.5pi]).range(0, 0.01);
//         high = high.dup(2) + (DelayC.ar(high, 0.01, lfo) * -2.dbamp);
//         snd = LPF.ar(snd, 100).dup(2) + high;
//         snd = RLPF.ar(snd, 7000, 2);
//         snd = BPeakEQ.ar(snd, \ffreq.kr(3000) * XLine.kr(1, 0.8, 0.3), 0.5, 15);
//         snd = snd * Env.asr(0.001, 1, 0.05).ar(2, \gate.kr(1));
//         Out.ar(\out.kr(0), snd * \amp.kr(0.1));
//     })
//   }
//
// (the note pattern of the comparison is in gabber_compare.scd: see 11_gabber_rave.harp)
//
// Every note is a new synth in SuperCollider: its saw starts at the start of the cycle, its envelopes
// at their start. In harp the instrument is a function (a new run of it for every note), play gives it
// the gate, and the numbers of the note (ffreq and bend) as signals; scSawSync and env start again on
// the rise of the gate. Notes go to two voices in turn, as the end of a note goes on while the next starts.

bpm = 210
steps = 4

fn gabberkick(gate, ffreq, bend) {
  freq = 60 * midiRatio(env(gate, [0 1 0], [0.001 0.08], -1) * 48 * bend)
  saw = scSawSync(freq, gate)
  snd = tanh(saw * 100) + (sign(saw) - saw) * dbAmp(-8)
  high = scHpf(snd, 300)
  lfo = [scSin(8, 0), scSin(8, 0.5 * pi)].range(0, 0.01)
  high2 = dup(high, 2) + scDelayC(high, 0.01, lfo) * dbAmp(-2)
  low = dup(scLpf(snd, 100), 2) + high2
  res = scRlpf(low, 7000, 2)
  eq = scPeq(res, ffreq * env(gate, [1 0.8], [0.3], shape: "exp", control: true), 0.5, 15)
  eq * env(gate, [0 1 0], [0.001 0.05], -4, release: 1) * dbAmp(-23)
}

out = play(gabberkick, dur: [1 1 1 1 0.75 0.25 0.5 0.75 0.25 0.5], legato: 0.8,
           fields: [geom(40, 100, 4000), [1 1 1 1 1 0.4 1 1 0.4 1]], voices: 2)
