// SuperCollider: "60Hz Gabber Rave 1995", the kick (9_gabber_kick.harp) and the hoover (10_hoover.harp) playing together, as the two Pbinds
// of the Ppar do, at 210 beats a minute:
//
//   Ppar([
//     Pbind(*[instrument: \gabberkick, amp: -23.dbamp, freq: 60, legato: 0.8,
//             ffreq: Pseq((0..(durations.size * 4 - 1)).normalize, inf).linexp(0, 1, 100, 4000),
//             dur: Pseq(durations, inf), bend: Pfuncn({ |x| if(x < (1/2), 0.4, 1) }, inf) <> Pkey(\dur)]),
//     Pbind(*[instrument: \hoover, amp: -20.dbamp, midinote: 74, dur: durations.sum * 2, sustain: 7])
//   ]).play(TempoClock(210 / 60));
//
// durations = [1, 1, 1, 1, 3/4, 1/4, 1/2, 3/4, 1/4, 1/2]
//
// harp compare cannot run a pattern: the reference is rendered by gabber_compare.scd (sclang gabber_compare.scd writes kick.wav,
// hoover.wav and full.wav), and
//
//   harp compare examples/supercollider/11_gabber_rave.harp -ref full.wav -seconds 20 -stats
//
// compares with it. The kick alone (-ref kick.wav, with 9_gabber_kick.harp) is the same wave as SuperCollider's, to -55 dB; the
// hoover has random detunes, so only its level and spectrum can be the same.

bpm = 210
steps = 4

fn gabberkick(gate, ffreq, bend) {
  freq = 60 * midiRatio(env(gate, [0 1 0], [0.001 0.08], -1) * 48 * bend)
  saw = scSawSync(freq, gate)
  snd = tanh(saw * 100) + (sign(saw) - saw) * dbAmp(-8)
  high = scHpf(snd, 300)
  lfo = [scSin(8, 0), scSin(8, 0.5 * pi)].range(0, 0.01)
  high2 = dup(high, 2) + scDelayC(high, 0.01, lfo) * dbAmp(-2)
  low = dup(scLpf(snd, 100), 2) + high2
  res = scRlpf(low, 7000, 2)
  eq = scPeq(res, ffreq * env(gate, [1 0.8], [0.3], shape: "exp", control: true), 0.5, 15)
  eq * env(gate, [0 1 0], [0.001 0.05], -4, release: 1) * dbAmp(-23)
}


// one of the twenty: two saws and a delay, each with random detunes and a random delay of its own
fn osc(i, freq) {
  bw = 1.035
  saws = scSaw(freq * expRand(bw, 1 / bw)) + scSaw(freq * 0.5 * expRand(bw, 1 / bw))
  scDelayN(saws, 0.01, rand(0, 0.01))
}

fn hoover(gate) {
  freq = hz(74) * midiRatio(env(gate, [-5 6 0], [0.1 1.7], [0 -4], control: true))
  mixed = atan(spread(fill(osc, 20, freq), 1) * 3)
  shaped = mixed * env(gate, [0 1 0], [0.01 1], -4, release: 1, control: true)
  verb = freeverb2(shaped, 0.3, 0.9)
  verb * env(gate, [0 1 0], [0 4], 6, release: 1, control: true) * dbAmp(-20)
}


beats = [1 1 1 1 0.75 0.25 0.5 0.75 0.25 0.5]

kick = play(gabberkick, dur: beats, legato: 0.8,
            fields: [geom(40, 100, 4000), [1 1 1 1 1 0.4 1 1 0.4 1]], voices: 2)
rave = play(hoover, dur: [14], sustain: 7, voices: 2)

out = kick + rave
