// SuperCollider (the example from the help files, as one function: sixteen random modulation stages, then two saws multiplied, through four bandpass filters)
//
//   {
//     var f, g, freq;
//     f = { | saw |
//       var freq, u, amp, rate;
//       rate = ExpRand(0.1, 2);
//       freq = if (0.6.coin) {
//         LFNoise1.kr(rate.dup).exprange(0.01, 10)
//       } {
//         LFNoise1.kr(rate.dup).exprange(10, 50)
//       };
//       u = LFSaw.kr(LinExp.kr(saw, -1, 1, freq, freq * LFNoise1.kr(rate.dup).exprange(2, 10)));
//       u = if (0.5.coin) {
//         u * [1 - saw, saw.reverse].choose
//       } {
//         u * LFSaw.kr(freq * 0.1, 0, 0.1, 1)
//       };
//       u.clip2(1.0)
//     };
//     g = { | func, n = 5 |
//       n.do { func = func <> func };
//       func
//     };
//     freq = g.(f, 4).value(LFSaw.kr(0.2 * [1, 1.1])).exprange(6, 11000);
//     BPF.ar(Saw.ar(freq).product, [70, 800, 9000, 5242], 0.2).sum.dup * 0.3
//   }
//
// The random choices are made when the patch is built, so every seed is another patch. g.(f, 4) is f
// after itself 2^4 = 16 times: repeat(stage, 16, ...). The saw is scsaw: SuperCollider's own, because this
// patch moves the frequency so fast that SuperCollider's Saw rings (peaks of 20 and more); the saw of harp
// does not, and the patch would sound other than it does there.
//
// harp compare of one seed says "different": the random numbers of SuperCollider and of harp are not the
// same numbers, so it is not the same patch. What can be the same is the sort of patch:
//
//   harp compare examples/supercollider/8_random_cascade.harp -seeds 100 -seconds 6
//
// renders seeds 1 to 100 in both and compares the distributions. The control signals are control: true,
// as SuperCollider's .kr (one value in 64 samples). Measured (SuperCollider seeded too, so that it repeats):
// the level, the brightness and most octave bands are distributed alike; two bands are not quite (the
// 1.4-2.8 kHz and the top octave, about 1 dB at the median, harp the darker). Without control: true the level
// differed too, and the ringing of the Saw is less often: the steps of the control signals matter.

seed = 8

fn stage(saw) {
  rate = exprand(0.1, 2)
  freq = if coin(0.6) {
    lfnoise([rate, rate], control: true).exprange(0.01, 10)
  } else {
    lfnoise([rate, rate], control: true).exprange(10, 50)
  }
  u = ramp(linexp(saw, -1, 1, freq, freq * lfnoise([rate, rate], control: true).exprange(2, 10)), control: true)
  v = if coin(0.5) {
    u * choose([1 - saw, reverse(saw)])
  } else {
    u * (ramp(freq * 0.1, control: true) * 0.1 + 1)
  }
  clip2(v, 1)
}

freq = repeat(stage, 16, ramp([0.2, 0.22], control: true)).exprange(6, 11000)
out = bpf(product(scsaw(freq)), [70, 800, 9000, 5242], 0.2).mix().dup() * 0.3
